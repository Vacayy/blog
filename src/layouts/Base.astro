---
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 사이트 루트 기준 OG 이미지 경로 */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** 같은 내용의 Markdown 버전 경로 (LLM용) */
  markdown?: string;
}

const {
  title,
  description = SITE.description,
  image = '/og.png',
  imageAlt = title ?? SITE.title,
  type = 'website',
  published,
  updated,
  noindex = false,
  jsonLd,
  markdown,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="naver-site-verification" content="9275d8468512db9f733282ff084c3a99078cbb66" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={new URL('/about/', Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header>
      <nav aria-label="주 메뉴">
        <a href="/" class="home" aria-current={path === '/' ? 'page' : undefined}>{SITE.title}</a>
        <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a>
        <button id="theme-toggle" type="button" aria-label="테마 전환">
          <svg class="icon-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
          <svg class="icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <svg class="icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>
        © {new Date().getFullYear()} {SITE.author} · <a href="/rss.xml">RSS</a> · <a href={SITE.github} rel="me">GitHub</a>
      </p>
    </footer>
    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const html = document.documentElement;
        const names = { system: '시스템', light: '라이트', dark: '다크' };
        const next = { system: 'dark', dark: 'light', light: 'system' };
        const sync = () => {
          const cur = html.dataset.theme || 'system';
          btn.setAttribute('aria-label', `테마 전환 (현재 ${names[cur]}, 누르면 ${names[next[cur]]})`);
        };
        sync();
        btn.addEventListener('click', () => {
          const cur = html.dataset.theme || 'system';
          const n = next[cur];
          if (n === 'system') {
            delete html.dataset.theme;
            try { localStorage.removeItem('theme'); } catch (e) {}
          } else {
            html.dataset.theme = n;
            try { localStorage.setItem('theme', n); } catch (e) {}
          }
          sync();
        });
      })();
    </script>
  </body>
</html>
